# ── Nexus AI frontend config (Phase 7.3) ───────────────────────────────────
# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
#
# LOCAL MODE (default): leave BOTH unset → the app talks to the legacy local
# orchestrator at ws://127.0.0.1:8765 with no auth, exactly as before.
#
# SaaS MODE: set both → the app connects to your central Brain server over the
# ngrok tunnel and authenticates with the invite key as its first message.

# Your server's public WebSocket URL. With `ngrok http 8000`, ngrok prints an
# https URL like https://abc123.ngrok-free.app — use the wss:// form + /ws:
VITE_NEXUS_WS_URL=wss://abc123.ngrok-free.app/ws
# VITE_NEXUS_WS_URL=https://meggan-spectacleless-nonreverentially.ngrok-free.dev
# The invite key for THIS client (must exist in server.py VALID_USERS).
VITE_NEXUS_INVITE_KEY=nexus_key_44bB

# Workspace the agent watches + indexes recursively. Saved files stream to your
# per-tenant vault and the agent can see your currently open file. Without this,
# the agent has no file awareness. Example:
VITE_NEXUS_WORKSPACE=/home/you/Projects/your-project
